rules_version = '2';

// ----------------------------------------------------------------------
// Reglas de seguridad de Cloud Storage — Pridethink
// ----------------------------------------------------------------------
// Mismo criterio y mismo flujo de publicación que firestore.rules: se
// escriben acá, se revisan, y se pegan A MANO en la consola de Firebase
// (Storage -> Rules -> Publish). Ver la regla 7 de CONTEXTO.md.
//
// El bucket guarda: la foto de perfil de cada persona
// (`profilePhotos/{uid}/avatar.jpg`, ver ProfilePhotoUploader.jsx), la
// imagen de cada producto de la Tienda (`productImages/{userId}/
// {productId}/{fileName}`, ver MultiImageUploader.jsx + CreateProductScreen.jsx,
// punto 59-60), las fotos de un post del muro (`postImages/{userId}/
// {postId}/{fileName}`, ver MultiImageUploader.jsx + Feed.jsx, punto 61) y
// la imagen de un mensaje de chat (`chatImages/{chatId}/{messageId}/
// {fileName}`, ver Chat.jsx, punto 61). Todo lo demás está cerrado con
// llave: si más adelante se agregan portadas de grupo/evento, hay que
// abrirles su propio bloque acá, a propósito — el catch-all del final no
// las va a dejar pasar solas.
//
// IMPORTANTE sobre `allow read`: las URLs que devuelve getDownloadURL()
// llevan un token y se sirven sin pasar por estas reglas, así que esta
// condición NO es lo que protege una foto ya compartida — es lo que
// impide listar/leer el bucket por ruta directa sin sesión iniciada. Se
// deja en "cualquier persona autenticada", el mismo nivel que ya tiene
// `users/{uid}` en firestore.rules (que es donde vive el photoURL).

service firebase.storage {
  match /b/{bucket}/o {

    // ------------------------------------------------------------------
    // profilePhotos/{uid}/avatar.jpg — foto de perfil
    // ------------------------------------------------------------------
    // Solo la propia persona puede subir, reemplazar o borrar la suya.
    // La ruta es fija (siempre "avatar.jpg"), así que una foto nueva pisa
    // a la anterior: nadie puede acumular archivos sueltos en el bucket.
    match /profilePhotos/{uid}/avatar.jpg {
      allow read: if request.auth != null;

      // El cliente ya redimensiona a 512x512 y exporta a JPEG antes de
      // subir (ProfilePhotoUploader.jsx), así que el resultado real pesa
      // decenas de KB. El tope de 2 MB acá es el respaldo del lado del
      // servidor, para alguien que llame al SDK directo salteándose la
      // interfaz — misma lógica que el resto de las validaciones de
      // firestore.rules: la interfaz propone, las reglas disponen.
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size < 2 * 1024 * 1024
        && request.resource.contentType == 'image/jpeg';

      // En un borrado no hay request.resource (no llega ningún archivo
      // nuevo), así que acá solo se valida quién es.
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // ------------------------------------------------------------------
    // productImages/{userId}/{productId}/{fileName} — imagen de producto
    // ------------------------------------------------------------------
    // Solo el vendedor (userId == su propio uid) puede escribir dentro de
    // su propia carpeta. A diferencia de la foto de perfil, acá SÍ importa
    // el productId en la ruta (un vendedor puede tener muchos productos a
    // la vez, cada uno con su propia imagen — no hay una sola ruta fija
    // que "pisar"), pero NO se valida que ese productId corresponda a un
    // documento real en products/{productId}: como en el resto de la app
    // (ver "camposDeProductoValidos" en firestore.rules, que tampoco
    // consulta otras colecciones), Storage Rules no puede hacer un get()
    // cruzado a Firestore de forma práctica acá, así que la única defensa
    // real es "userId == quien está subiendo" — igual que profilePhotos.
    // "fileName" queda libre a propósito: CreateProductScreen.jsx sube
    // hasta 5 fotos por producto (punto 60, MultiImageUploader.jsx),
    // numeradas "img_0.jpg".."img_4.jpg" — no hace falta forzar ese
    // patrón en la regla, la app nunca sube nada más ahí.
    match /productImages/{userId}/{productId}/{fileName} {
      allow read: if request.auth != null;

      // ImageUploader.jsx redimensiona a maxSize manteniendo aspect ratio
      // y exporta a JPEG antes de subir, así que el resultado real pesa
      // poco. El tope de 5 MB acá (más alto que los 2 MB de la foto de
      // perfil, porque una foto de producto puede necesitar más detalle
      // que un avatar circular chico) es el respaldo del servidor para
      // alguien que llame al SDK directo salteándose la interfaz.
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');

      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // ------------------------------------------------------------------
    // postImages/{userId}/{postId}/{fileName} — foto de un post del muro
    // ------------------------------------------------------------------
    // Copia exacta del bloque de productImages de arriba, mismo motivo:
    // solo el autor (userId == su propio uid) escribe dentro de su propia
    // carpeta, el postId no se valida contra un documento real en
    // posts/{postId} (misma limitación de Storage Rules explicada arriba),
    // y "fileName" queda libre — Feed.jsx sube hasta 4 fotos por post
    // (punto 61, MultiImageUploader.jsx), numeradas "img_0.jpg".."img_3.jpg".
    match /postImages/{userId}/{postId}/{fileName} {
      allow read: if request.auth != null;

      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');

      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // ------------------------------------------------------------------
    // chatImages/{chatId}/{messageId}/{fileName} — imagen de un mensaje
    // ------------------------------------------------------------------
    // A diferencia de los dos bloques de arriba (una sola persona dueña
    // de la carpeta), acá los DOS participantes del chat necesitan poder
    // leer Y escribir — mismo criterio exacto que ya usa
    // esParticipanteDelChat() en firestore.rules para
    // chats/{chatId}/messages/{messageId}: separar el chatId por "_" (así
    // se arma en getChatId(), Chat.jsx) y confirmar que el uid de quien
    // pide es una de las dos mitades. Storage Rules usa el mismo lenguaje
    // que Firestore Rules, así que "chatId.split('_')" funciona igual acá.
    // "fileName" siempre es "img.jpg" (Chat.jsx sube UNA sola imagen por
    // mensaje, cada mensaje ya tiene su propia carpeta por messageId, así
    // que no hace falta numerar como en productImages/postImages).
    match /chatImages/{chatId}/{messageId}/{fileName} {
      allow read: if request.auth != null && request.auth.uid in chatId.split('_');

      allow create, update: if request.auth != null
        && request.auth.uid in chatId.split('_')
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');

      allow delete: if request.auth != null && request.auth.uid in chatId.split('_');
    }

    // ------------------------------------------------------------------
    // Todo lo demás: cerrado
    // ------------------------------------------------------------------
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
